{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FlightCache": {
    "TtlSeconds": 5
  },
  "Providers": {
    "AdsbLol": {
      "BaseUrl": "https://api.adsb.lol/",
      "TotalTimeoutSeconds": 8,
      "AttemptTimeoutSeconds": 3,
      "MaxRetries": 2
    }
  }
}
