{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenLimit": 20,
    "TokensPerPeriod": 1,
    "ReplenishmentPeriodSeconds": 2,
    "NewOwners": {
      "PermitLimit": 5,
      "WindowMinutes": 60
    }
  },
  "Poller": {
    "WatchSeconds": 30
  },
  "FlightCache": {
    "TtlSeconds": 5
  },
  "Logos": {
    "UrlTemplates": [
      "https://raw.githubusercontent.com/Jxck-S/airline-logos/main/flightaware_logos/{code}.png",
      "https://raw.githubusercontent.com/Jxck-S/airline-logos/main/radarbox_logos/{code}.png"
    ],
    "CacheHours": 24
  },
  "Routes": {
    "BaseUrl": "https://vrs-standing-data.adsb.lol/",
    "WaitMilliseconds": 300,
    "CacheMinutes": 60
  },
  "Providers": {
    "Active": "AdsbLol",
    "OpenSky": {
      "BaseUrl": "https://opensky-network.org/api/"
    },
    "AdsbLol": {
      "BaseUrl": "https://api.adsb.lol/",
      "TotalTimeoutSeconds": 8,
      "AttemptTimeoutSeconds": 3,
      "MaxRetries": 2,
      "MaxConcurrentRequests": 10,
      "MaxQueuedRequests": 20
    }
  }
}