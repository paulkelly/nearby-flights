{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenLimit": 20,
    "TokensPerPeriod": 1,
    "ReplenishmentPeriodSeconds": 2
  },
  "FlightCache": {
    "TtlSeconds": 5
  },
  "Providers": {
    "AdsbLol": {
      "BaseUrl": "https://api.adsb.lol/",
      "TotalTimeoutSeconds": 8,
      "AttemptTimeoutSeconds": 3,
      "MaxRetries": 2
    }
  }
}