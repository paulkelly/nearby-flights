<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's foreground layer: web/public/logo.svg's radar rings and plane, without its blue square (that's the
     background layer). Adaptive icons are 108 dp, but launchers may cut away everything outside the middle 66 dp, so
     the art is scaled from the SVG's 512 units by 0.155: the outer ring (radius 190 + half its stroke) ends ~30.5 dp
     from the centre, inside the 33 dp safe zone. Groups apply scale, then rotation, then translation, so the SVG's
     "translate rotate scale translate" becomes nested groups, innermost first. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.155"
        android:scaleY="0.155"
        android:translateX="54"
        android:translateY="54">
        <!-- "Radar" rings, a nod to the search circle -->
        <path
            android:pathData="M-190,0a190,190 0,1 0,380 0a190,190 0,1 0,-380 0z"
            android:strokeWidth="14"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.28" />
        <path
            android:pathData="M-118,0a118,118 0,1 0,236 0a118,118 0,1 0,-236 0z"
            android:strokeWidth="10"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.18" />
        <!-- The map marker's plane (24×24), scaled ×10 and turned to point north-east -->
        <group
            android:rotation="45"
            android:scaleX="10"
            android:scaleY="10">
            <group
                android:translateX="-12"
                android:translateY="-12">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M12,2L13.5,9L21,13L21,15L13.5,12.5L13,18L15.5,20L15.5,21.5L12,20.5L8.5,21.5L8.5,20L11,18L10.5,12.5L3,15L3,13L10.5,9Z" />
            </group>
        </group>
    </group>
</vector>
