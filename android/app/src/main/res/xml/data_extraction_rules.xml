<?xml version="1.0" encoding="utf-8"?>
<!-- Backups (Android 12+): cloud backup, and moving to a new phone (device transfer). Everything is included, owner
     token too, except the installation ID: the new or restored phone must register with the server as a new device,
     not take over the old phone's watches and pushes. Keep in step with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/device.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/device.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
