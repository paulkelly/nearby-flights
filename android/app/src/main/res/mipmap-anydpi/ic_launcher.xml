<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon (same as the web app's, web/public/logo.svg). Adaptive: the launcher masks the layers to its shape and
     can animate them. Every Android this app supports (8.0+) uses this, so there are no PNG/WebP fallbacks. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
