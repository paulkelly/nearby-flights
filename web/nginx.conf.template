# nginx config for the web container. ${API_URL} and ${NGINX_LOCAL_RESOLVERS} are filled in from environment
# variables when the container starts (see the Dockerfile). nginx's own $variables are left alone, because the
# template step only replaces variables that exist in the environment.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off; # don't advertise the nginx version in headers and error pages

    # Compress text responses. The JS bundle shrinks from ~400 kB to ~125 kB on the wire.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Look up the API's address at request time via the container's DNS server, re-checking every 10 s.
    # Without a resolver, nginx resolves "api" once at startup and refuses to start if the API container
    # isn't up yet; it would also keep using a stale IP after the API container restarts.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # ---- API: forward to the backend, like Vite's dev proxy does locally ----
    location /api/ {
        # Using a variable is what makes nginx honour the resolver above (a literal URL is resolved once).
        # With no path after host:port, the original request path and query string are passed on unchanged.
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;

        # Tell the API who the real client is and how they connected; nginx is now the one making the request.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Static files ----
    # Vite puts a content hash in asset file names (index-BFyy….js), so a changed file gets a new name.
    # That makes it safe to let browsers cache them for a year without ever asking again.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html is the one file whose name never changes, so browsers must check for a new version each time;
    # otherwise users could keep running an old build after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The service worker must never be cached long-term. The browser checks sw.js to discover new versions of
    # the app; a cached copy would hide every deploy until the cache expired.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # nginx's built-in MIME list has no entry for .webmanifest, so without this it's sent as a generic binary
    # file. Also revalidated each time, so name/icon changes reach installed apps.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Anything else: the file if it exists, otherwise the app's index.html. That fallback is the standard setup
    # for single-page apps (client-side routes like /flights/abc have no file on disk).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
