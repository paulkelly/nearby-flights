# Copy to .env (git-ignored) next to compose.yaml and fill in. Compose reads .env automatically; every value is
# optional. Never commit .env, and never put these values in compose.yaml or appsettings*.json.

# Host port for the web app (default 8080).
WEB_PORT=

# Required: the password of the app's Postgres user. Letters and digits only (it goes inside a connection string,
# where ; and = mean something). Postgres sets it when it first creates its volume; to change it afterwards, delete
# the volume (docker compose down -v, which deletes saved locations) or change it in the database too.
# One way to make one in PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
POSTGRES_PASSWORD=

# Host port Postgres is published on, for psql and Rider (default 5432; only this machine can connect).
POSTGRES_PORT=

# Which flight data source serves requests: AdsbLol (default) or OpenSky.
FLIGHT_PROVIDER=

# Which source to try when that one fails: OpenSky, AdsbLol, or None. Empty = OpenSky backs up adsb.lol, and
# nothing backs up OpenSky.
FLIGHT_FALLBACK=

# OpenSky API client (create one on https://opensky-network.org/my-opensky/account). Leave both empty to use
# OpenSky anonymously (400 credits a day instead of 4,000).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=