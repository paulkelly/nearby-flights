# Copy to .env (git-ignored) next to compose.yaml and fill in. Compose reads .env automatically; every value is
# optional. Never commit .env, and never put these values in compose.yaml or appsettings*.json.

# Host port for the web app (default 8080).
WEB_PORT=

# Which flight data source serves requests: AdsbLol (default) or OpenSky.
FLIGHT_PROVIDER=

# OpenSky API client (create one on https://opensky-network.org/my-opensky/account). Leave both empty to use
# OpenSky anonymously (400 credits a day instead of 4,000).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=